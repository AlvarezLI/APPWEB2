# Copiar este archivo como .env y completar los valores

PORT=3000

# Local:  mongodb://127.0.0.1:27017/nuvea
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/nuvea
MONGODB_URI=mongodb://127.0.0.1:27017/nuvea

# Secret propio para firmar los tokens (se puede generar en https://jwt.io/)
JWT_SECRET=cambiar-por-un-secret-propio
JWT_EXPIRES_IN=2h
